{
    "version": 1,
    "hooks": {
        "preToolUse": [
            {
                "type": "command",
                "command": "node hooks/tool-guardian/guard-tool.mjs",
                "timeoutSec": 10,
                "env": {
                    "GUARD_MODE": "warn"
                }
            },
            {
                "type": "command",
                "command": "bun hooks/scripts/raw-immutability-guard.ts",
                "timeoutSec": 10
            }
        ],
        "postToolUse": [
            {
                "type": "command",
                "command": "bun hooks/scripts/validate-memories-frontmatter.ts",
                "timeoutSec": 20
            },
            {
                "type": "command",
                "command": "bun hooks/scripts/validate-wiki-crossrefs.ts",
                "timeoutSec": 30
            },
            {
                "type": "command",
                "command": "bun hooks/scripts/entity-registry-guard.ts",
                "timeoutSec": 15
            },
            {
                "type": "command",
                "command": "bun hooks/scripts/validate-log-format.ts",
                "timeoutSec": 10
            }
        ]
    }
}